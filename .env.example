# Copy this file to .env for local testing (never commit the real .env).
# On your hosting platform (Render, Railway, etc.), set these same names as
# environment variables / secrets in its dashboard -- do not put real values
# in this file or in app.py.

# Required for the AI audit ("Compile & Audit") and Hint features to work.
OPENAI_API_KEY=sk-...

# Required to protect the site behind a single shared login. If either of
# these is left unset, the login gate is disabled (fine for local testing,
# NOT fine for a public deployment).
APP_USERNAME=changeme
APP_PASSWORD=changeme

# Optional. Defaults shown below -- how many /api/grade + /api/hint calls
# (combined) a single visitor's IP address can make before being throttled.
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=3600

# Optional. Leave unset (or "0") in production. Only set to "1" for local
# debugging -- debug mode exposes an interactive code console on error pages.
FLASK_DEBUG=0
